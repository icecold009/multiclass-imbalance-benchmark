# Python environments and caches
.venv/
.python312/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local secrets and environment files
.env
.env.*
!.env.example

# Raw and generated data are not committed by default.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
results/*
!results/.gitkeep
artifacts/runs/*
!artifacts/runs/.gitkeep
artifacts/test-tmp/*
artifacts/test-cache/*
artifacts/environment/*
!artifacts/environment/.gitkeep

# Local notebooks and logs
.ipynb_checkpoints/
*.log

# LaTeX build outputs; keep only the manuscript source and official style files.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.out
paper/*.pdf
paper/*.synctex.gz
paper/*.toc

# Local paper release artifacts
output/
