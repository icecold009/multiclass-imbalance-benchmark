# Python environments and caches
.venv/
.venv-v2/
.python312/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local secrets and environment files
.env
.env.*
!.env.example

# Raw and generated data are not committed by default.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
results/*
!results/.gitkeep
artifacts/runs/*
!artifacts/runs/.gitkeep
artifacts/test-tmp/*
artifacts/test-cache/*
artifacts/environment/*
!artifacts/environment/.gitkeep
!artifacts/environment/
!artifacts/environment/v2/
!artifacts/environment/v2/*

# Local notebooks and logs
.ipynb_checkpoints/
*.log
